# ---- Database (Neon free tier — postgres) ----
# Local dev o ei same Neon URL din, ba nijer local postgres.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ---- Auth ----
# Production e (Render) JWT_SECRET auto-generate hoy. Local er jonno random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES="7d"

# ---- MikroTik ----
# Router password AES-256-GCM diye encrypt kore DB-te thake. Ei key na dile JWT_SECRET
# theke derive hobe. Production e alada lomba random string din.
MIKROTIK_SECRET=""

# ---- Server ----
PORT=4000
# Frontend origin — CORS. Live-e apnar frontend URL (comma diye multiple dite parben).
CLIENT_ORIGIN="http://localhost:5173"
